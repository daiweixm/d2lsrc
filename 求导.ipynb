   "source": [
    "# 自动求导\n",
    "# 假设我们想对函数y=2x^2关于x的导数进行求导\n",
    "import torch\n",
    "\n",
    "x = torch.arange(4.0)\n",
    "print(x)\n",
    "# 计算y\n",
    "y = 2 * torch.dot(x, x)\n",
    "print(y)\n",
    "\n"
   ]
  }
 ],
